3. DATA SCHEMA SPECIFICATION (datos.json)
--------------------------------------------------------------------
Type: Object

Schema Definition:
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "inventario": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "producto": { "type": "string" },
          "stock": { "type": "integer" }
        },
        "required": ["producto", "stock"]
      }
    },
    "solicitudes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "producto": { "type": "string" },
          "cantidad": { "type": "integer" },
          "estado": { 
            "type": "string",
            "enum": ["pendiente", "Aceptado", "Rechazado", "Inválido"] 
          },
          "motivo": { "type": "string" }
        },
        "required": ["id", "producto", "cantidad", "estado", "motivo"]
      }
    }
  },
  "required": ["inventario", "solicitudes"]
}

